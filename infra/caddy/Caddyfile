# Borde HTTPS de la demo (compose.prod.yaml). Caddy obtiene y renueva solo el certificado
# de Let's Encrypt para {$DOMAIN} y redirige http → https.
{
	servers {
		# Solo TCP: en la Security List de Oracle se abren 80/443 TCP, no UDP (HTTP/3).
		protocols h1 h2
	}
}

{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy proxy:80
}
