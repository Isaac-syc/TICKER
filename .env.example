# Copia este archivo a .env (cp .env.example .env). Los valores son solo para desarrollo local.

# --- General ---
APP_ENV=dev
APP_TIMEZONE=America/Mexico_City
LOG_LEVEL=INFO
# true = logs en JSON (recomendado en contenedores); false = formato legible para consola
LOG_JSON=true
PROXY_PORT=8080
# Postgres y Redis se publican solo en 127.0.0.1 (HeidiSQL, RedisInsight). Cámbialos si chocan.
DB_PORT=5432
REDIS_PORT=6379

# --- Base de datos ---
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev_pw
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk_dev_pw@db:5432/helpdesk

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT / sesiones ---
# Genera uno propio: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me-3f9c1d7e5b2a4c6d8e0f1a3b5c7d9e1f
JWT_ISSUER=helpdesk-ti
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# true en producción (HTTPS). En http://localhost puede quedarse en false.
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TAB_LEASE_TTL_SECONDS=90

# --- SLA (horas por prioridad) ---
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72

# --- Seed (usuarios demo; solo desarrollo) ---
SEED_ADMIN_EMAIL=admin@helpdesk.test
SEED_ADMIN_PASSWORD=Admin#2026!
SEED_USER_EMAIL=usuario@helpdesk.test
SEED_USER_PASSWORD=Usuario#2026!
SEED_OBSERVER_EMAIL=observador@helpdesk.test
SEED_OBSERVER_PASSWORD=Observador#2026!
# Crea técnicos y ~200 tickets de ejemplo para que el dashboard tenga datos
SEED_DEMO_DATA=true
